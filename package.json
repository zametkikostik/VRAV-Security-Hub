{
  "name": "vrav-security-hub",
  "private": true,
  "version": "0.5.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "build": "vite build && esbuild server.ts githubRoutes.ts auditLog.ts operatorConfig.ts appStore.ts ipfsRoutes.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
    "preview": "node dist/server.cjs",
    "clean": "rm -rf dist server.js dist/server.cjs dist/server.cjs.map uploads data/audit.jsonl",
    "lint": "tsc --noEmit",
    "start": "node dist/server.cjs",
    "deploy:slash": "bash contracts/deploy_slash.sh"
  },
  "dependencies": {
    "@google/genai": "^1.29.0",
    "@rainbow-me/rainbowkit": "^2.2.4",
    "@tailwindcss/vite": "^4.1.14",
    "@tanstack/react-query": "^5.66.0",
    "@vitejs/plugin-react": "^5.0.4",
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.0.0",
    "jose": "^6.0.8",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "multer": "^1.4.5-lts.1",
    "pg": "^8.13.3",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "siwe": "^3.0.0",
    "viem": "^2.23.2",
    "vite": "^6.2.3",
    "wagmi": "^2.14.11",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/multer": "^1.4.12",
    "@types/node": "^22.14.0",
    "@types/pg": "^8.11.11",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.0",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2"
  }
}
