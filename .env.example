# Server
PORT=3000
NODE_ENV=development

ADMIN_API_TOKEN=change-me-to-long-random-string
VITE_ADMIN_API_TOKEN=

# Required in production for SIWE mutations (comma-separated)
ADMIN_WALLETS=

JWT_SECRET=change-me-to-long-random-secret-at-least-32-chars

GEMINI_API_KEY=
VIRUSTOTAL_API_KEY=
AUDIT_MAX_CHARS=80000

VITE_WALLETCONNECT_PROJECT_ID=

GITHUB_TOKEN=
GITHUB_CATALOG_PRESETS=zametkikostik/VRAV-Security-Hub
ALLOW_REMOTE_HASH=false

# Optional: postgres audit sink (also always writes data/audit.jsonl)
# DATABASE_URL=postgres://user:pass@localhost:5432/vrav
