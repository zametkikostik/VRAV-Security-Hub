# Server
PORT=3000
NODE_ENV=development

# Protects POST /api/apps, POST /api/slash, POST /api/scan-file
ADMIN_API_TOKEN=change-me-to-long-random-string

# Optional: same value for local frontend mutations (dev only)
VITE_ADMIN_API_TOKEN=change-me-to-long-random-string

# Google AI
GEMINI_API_KEY=

# Optional: https://www.virustotal.com/gui/my-apikey
VIRUSTOTAL_API_KEY=

# Max code size for AI audit (characters)
AUDIT_MAX_CHARS=80000

# Web3 / RainbowKit — https://cloud.walletconnect.com
VITE_WALLETCONNECT_PROJECT_ID=
