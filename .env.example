# Server
PORT=3000
NODE_ENV=development

# Legacy break-glass for scripts (optional if SIWE works)
ADMIN_API_TOKEN=change-me-to-long-random-string

# Optional dev-only frontend fallback (prefer SIWE)
VITE_ADMIN_API_TOKEN=

# Comma-separated allowlist. Empty = any SIWE-authenticated wallet may mutate (demo).
# Example: ADMIN_WALLETS=0x71C7656EC7ab88b098defB751B7401B5f6d8976F
ADMIN_WALLETS=

# JWT signing secret for SIWE sessions (required for SIWE)
JWT_SECRET=change-me-to-long-random-secret-at-least-32-chars

# SIWE domain/URI overrides (defaults from request Host)
# SIWE_DOMAIN=localhost:3000
# SIWE_URI=http://localhost:3000

# Google AI
GEMINI_API_KEY=

# Optional VirusTotal
VIRUSTOTAL_API_KEY=

AUDIT_MAX_CHARS=80000

# Web3 / RainbowKit — https://cloud.walletconnect.com
VITE_WALLETCONNECT_PROJECT_ID=
